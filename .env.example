# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it is gitignored.
# This file documents every key the tools expect. Keep it in sync as tools are added.
# NEVER put real key values in this file — names and source URLs only.

# --- LLM / AI ---
# Used by Claude site-analysis + personalization steps.
# Get it from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL: Claude model for lead analysis; defaults to claude-sonnet-5 when unset.
LEADGEN_MODEL=

# --- Apify (Google Maps Scraper actor: compass/google-maps-scraper) ---
# Used by tools/scrape_google_maps.py.
# Get it from https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# --- Firecrawl (website scrape fallback when Jina fails) ---
# Get it from https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- B2B data API (person leads, V2 Stage 3) ---
# A paid contact-database vendor (Apollo.io / PeopleDataLabs
# class). Both values come with the account; people search stays unavailable
# (and the UI says so) until they are set.
B2B_DATA_API_KEY=
# The vendor's people-search endpoint URL.
B2B_DATA_API_URL=

# --- Jina Reader (OPTIONAL: higher rate limits for faq_agent's crawler) ---
# Basic scraping works with no key; set this only if you hit rate limits.
# Get it from https://jina.ai/reader
JINA_API_KEY=

# --- Outreach sender identity ---
# Appended as the signature to every generated email (Email Body column).
# Your name and the phone number prospects should reply/call.
SENDER_NAME=
SENDER_PHONE=

# Physical mailing address for the CAN-SPAM footer (a UPS-store box works).
# REQUIRED before real sends; may stay empty while DRY_RUN=true.
SENDER_ADDRESS=

# --- Outreach sending (Stage 2) ---
# SAFETY DEFAULT: dry run. Set to false only when domain+mailboxes are warmed
# and you intend real cold email to go out.
DRY_RUN=true

# Comma-separated sending mailboxes on the (separate) sending domain,
# e.g. you@yoursendingdomain.com,outreach@yoursendingdomain.com
SMTP_MAILBOXES=

# One app password per mailbox: SMTP_PASS_<LOCALPART upper, non-alnum -> _>
# e.g. for you@yoursendingdomain.com: SMTP_PASS_YOU=
#      for outreach@yoursendingdomain.com: SMTP_PASS_OUTREACH=
# (Google account -> Security -> 2-Step Verification ON -> App passwords.)

# Web app root used in unsubscribe links. Localhost until final deploy,
# then the Render URL.
BASE_URL=http://localhost:8000

# HMAC key for unsubscribe tokens - any long random string, keep it stable.
UNSUBSCRIBE_SECRET=

# --- Accounts & multi-tenancy (V2 Stage 4) ---
# HMAC key for login session cookies - any long random string, keep it
# stable (changing it logs everyone out). REQUIRED before deploy; when unset
# a random per-process secret is used and sessions reset on every restart.
SESSION_SECRET=

# The address that becomes the admin account (owner workspace, unmetered).
# Optional: when unset, the first account to log in becomes the admin. Set it
# before you share a deployed server's URL so nobody else can claim it.
OWNER_EMAIL=

# --- Supabase (database + login) ---
# Leave both keys blank to run as a single local user with no login (plain
# http only). Setup steps are in README.md. All three come from the Supabase
# dashboard of your project.
# Project Settings -> API -> Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Project Settings -> API -> the public "anon" key (NOT the service_role key).
SUPABASE_ANON_KEY=
# Connect -> "Session pooler" connection string (port 5432), with your
# database password filled in. Leave EMPTY and the app falls back to a local
# SQLite file at data/leads.db (what the offline test suite uses).
DATABASE_URL=

# Emergency stop: true = sequencer ticks do nothing (or create a PAUSED file
# in the data dir / use the web UI button).
OUTREACH_PAUSED=

# --- Billing (V2 Stage 5, Dodo Payments — Merchant of Record) ---
# ALL empty until the owner opens the Dodo account (dodopayments.com).
# The Billing page honestly says "payments not connected" while these are
# unset; the webhook endpoint rejects everything without the secret.
DODO_API_KEY=
# Webhook signing secret from the Dodo dashboard (starts with whsec_).
DODO_WEBHOOK_SECRET=
# test | live (controls which checkout host links point at).
DODO_ENV=test
# One product id per paid tier, created in the Dodo dashboard.
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=

# --- Tenant mailboxes (V2 Stage 6) ---
# Encryption key for customers' stored mailbox logins (Fernet). Generate:
#     python tools/mailboxes.py --genkey
# CRITICAL: put a copy in your password manager. Losing this key makes every
# stored mailbox login unreadable and customers must reconnect.
MAILBOX_ENC_KEY=
# Only during a key rotation: move the old key here, put the new key above,
# run `python tools/mailboxes.py --rotate-key`, then delete this line's value.
MAILBOX_ENC_KEY_OLD=

# --- Alerts (Stage 5) ---
# Telegram bot: message @BotFather -> /newbot -> copy token. Then message
# your bot once, open https://api.telegram.org/bot<TOKEN>/getUpdates and
# read chat.id from the JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fallback channel: if Telegram is unset/down, alerts go to this address
# via the Stage-2 SMTP mailboxes. Leave empty to skip the email fallback.
ALERT_EMAIL=

# --- GoHighLevel CRM sync (Stage 4, OPTIONAL) ---
# Off by default: the built-in /pipeline table needs none of this. Set to
# true only for a client who lives in GHL.
GHL_SYNC_ENABLED=false

# Private Integration token from the GHL SUB-ACCOUNT (not agency level):
# Settings -> Private Integrations -> create, scopes: contacts + opportunities.
GHL_API_TOKEN=

# The sub-account (location) id — Settings -> Business Profile.
GHL_LOCATION_ID=
